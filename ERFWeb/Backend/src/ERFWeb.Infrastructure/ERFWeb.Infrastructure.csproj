<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ERFWeb.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin the EF Core family to one version so the naming-conventions and Npgsql
         provider dependencies unify (avoids MSB3277 version conflicts). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <!-- PDF rule (README "PDF libraries"): QuestPDF draws the exports and the R47 by default; PDFsharp draws
         the R47 when R47Report:Engine = PdfSharp and works on existing PDF files.
         PDFsharp is pinned to exactly 6.2.4, the last MIT release: 6.5.0 and later are AGPL-3.0 or a paid
         licence and refuse to run until one is selected in code. Do not upgrade without a licence decision. -->
    <PackageReference Include="QuestPDF" Version="2025.12.4" />
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit (via MailKit) pulls Pkcs 10.0.0, which has known advisories (NU1902/NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Reporting\Assets\mdmpi-logo.png" LogicalName="ERFWeb.Infrastructure.Reporting.Assets.mdmpi-logo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ERFWeb.Application\ERFWeb.Application.csproj" />
    <ProjectReference Include="..\ERFWeb.Domain\ERFWeb.Domain.csproj" />
  </ItemGroup>
</Project>
