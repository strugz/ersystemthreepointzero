{
  "_comment": "TEMPLATE ONLY. Copy this file to appsettings.json (same folder), fill in the real values, and never commit appsettings.json (it is gitignored).",

  "ConnectionStrings": {
    "Postgres": "Host=YOUR_DB_HOST;Port=5432;Database=erfweb;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },

  "Authentication": {
    "SessionCookieName": "ERFWeb.Session",
    "SessionHours": 8,
    "SlidingExpiration": true,
    "AntiforgeryCookieName": "ERFWeb.Xsrf",
    "AntiforgeryHeaderName": "X-CSRF-TOKEN"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },

  "Swagger": {
    "Enabled": false
  },

  "R47Report": {
    "CompanyName": "Marsman Drysdale Medical Products, Inc.",
    "CompanyShortName": "MDMPI",
    "Title": "EXPENSE REPORT",
    "DocumentCode": "R47",
    "EffectivityDate": "May 15, 2023",
    "RevisionNo": "0",
    "RowsPerPage": 16,
    "UtcOffsetHours": 8,
    "HeaderFont": "Calibri",
    "BodyFont": "Times New Roman",
    "QuestPdfLicense": "Community"
  },

  "Attachments": {
    "MaxFileSizeMb": 10,
    "MaxFilesPerReport": 20,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "application/pdf"
    ]
  },

  "ReferenceNumber": {
    "Prefix": "ERF",
    "Digits": 6,
    "UtcOffsetHours": 8
  },

  "Lasius": {
    "Url": "https://YOUR_LASIUS_HOST/api/sms",
    "ApiKey": "YOUR_LASIUS_API_KEY",
    "ApiKeyHeaderName": "X-API-Key",
    "Application": "ERMS",
    "TimeoutSeconds": 30
  },

  "Smtp": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "Security": "StartTls",
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromAddress": "erfweb@YOUR_DOMAIN",
    "FromName": "ERFWeb",
    "TimeoutSeconds": 30
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
