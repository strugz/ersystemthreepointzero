# The SPA calls same-origin /api; Vite proxies it to the API host below in dev.
VITE_API_TARGET=https://sr.mdmpi.com.ph/erf/
# nginx forwards /erf/* to the API's /api/*, so drop the SPA's /api prefix before proxying.
VITE_API_PROXY_STRIP_PREFIX=true
# test or prod. test shows the System Administrator's Delete buttons for test data; the API refuses them
# unless its appsettings.json has App:Mode Test. This file is committed and Render builds from it, so keep
# prod here and put VITE_APP_MODE=test in .env.local (or the build's environment) for a test build.
VITE_APP_MODE=prod
